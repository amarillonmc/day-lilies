# Local development: npm run dev; production build: npm run build && npm start
HOST=127.0.0.1
PORT=3001
DATA_DIR=.data

# Required when HOST is not loopback. Use the externally visible origin.
# PUBLIC_ORIGIN=https://cards.example.com

# Optional exact hostnames/IP addresses permitted for private or HTTP model endpoints.
# Example for Ollama on this machine: BYOK_ALLOWED_HOSTS=localhost,127.0.0.1
# Never add an API Key here. The user supplies their Key per generation request.
BYOK_ALLOWED_HOSTS=

# Optional token for GitHub reference-sync API rate limits (never sent to model providers).
# GITHUB_TOKEN=
