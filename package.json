{
  "name": "day-lilies",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first Yu-Gi-Oh! DIY card workshop with Lua and expansion exports.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "refs:sync": "tsx scripts/sync-references.ts",
    "assets:sync": "node scripts/sync-assets.mjs",
    "postinstall": "node scripts/sync-assets.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "idb-keyval": "^6.3.0",
    "jszip": "^3.10.2",
    "luaparse": "^0.3.1",
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sql.js": "^1.14.2",
    "ygopro-cdb-encode": "^1.1.1",
    "yugioh-card": "^1.9.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/express": "^5.0.6",
    "@types/luaparse": "^0.2.13",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "koishipro-core.js": "^1.5.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "ygopro-jstest": "^1.1.7"
  }
}
